# Shopify storefront
SHOPIFY_STORE_DOMAIN=
SHOPIFY_PUBLIC_ACCESS_TOKEN=

# Shopify Admin API (newsletter — write_customers + write_customers_marketing_consent)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Cache revalidation (POST /api/revalidate)
SHOPIFY_REVALIDATION_SECRET=

# Newsletter confirm-token HMAC (do not reuse SHOPIFY_REVALIDATION_SECRET)
NEWSLETTER_CONFIRM_SECRET=

# Resend (double opt-in confirmation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public site origin for confirmation links (https, no trailing slash).
# Required in production so confirm emails never take Host / X-Forwarded-* from the request.
# On Vercel preview, omit this to use VERCEL_URL for the current deployment.
NEXT_PUBLIC_SITE_URL=

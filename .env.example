# Shopify store domain (canonical Hydrogen name).
# Legacy fallback: SHOPIFY_STORE_DOMAIN
PUBLIC_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API token (optional; omit for tokenless / mock.shop).
# Do not set an empty value — leave commented until you have a token.
# Legacy fallback: SHOPIFY_PUBLIC_ACCESS_TOKEN
# PUBLIC_STOREFRONT_API_TOKEN=

# Private Storefront API token (server-only; prefer over public for SSR).
# Legacy fallback: SHOPIFY_PRIVATE_ACCESS_TOKEN
PRIVATE_STOREFRONT_API_TOKEN=

# Hydrogen storefront ID. Use "0" when unknown.
PUBLIC_STOREFRONT_ID=0

# Optional: app-level checkout domain for CSP (checkout URLs still come from cart.checkoutUrl).
# PUBLIC_CHECKOUT_DOMAIN=

# Legacy revalidation secret (still used by existing app webhook/revalidate routes).
# SHOPIFY_REVALIDATION_SECRET=

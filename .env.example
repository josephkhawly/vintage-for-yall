# Shopify storefront (required)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_PUBLIC_ACCESS_TOKEN=

# Shopify Admin API — newsletter signup (create/update customers + email marketing consent)
# Needs scopes that can write customers and update email marketing consent.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Cache revalidation webhook secret (POST /api/revalidate)
SHOPIFY_REVALIDATION_SECRET=

# Dedicated HMAC secret for newsletter confirmation tokens.
# Do not reuse SHOPIFY_REVALIDATION_SECRET.
NEWSLETTER_CONFIRM_SECRET=

# Resend — double opt-in confirmation emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public site origin used in confirmation email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=
